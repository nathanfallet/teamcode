<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- The app's own group first, so the accounts' tokens stay where they were (the default group); the push key is in
	     the second, the only one the notification service extension lists. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)me.nathanfallet.teamcode$(TEAM_ID)</string>
		<string>$(AppIdentifierPrefix)me.nathanfallet.teamcode$(TEAM_ID).push</string>
	</array>
</dict>
</plist>
